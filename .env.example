VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu_clave_publica_o_anon

# No pongas SUPABASE_SECRET_KEY en React. Esa clave solo debe vivir en servidor.
# En Netlify configura estas variables desde Site configuration > Environment variables
# y habilita el alcance Functions para la clave secreta.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=tu_clave_secreta_solo_servidor
API_SESSION_SECRET=una_cadena_privada_larga_y_aleatoria

# Reporte automatico de asistencia (solo backend / Netlify Functions).
# Usa una contrasena de aplicacion de Google, nunca la contrasena normal de Gmail.
GMAIL_USER=calzado661@gmail.com
GMAIL_APP_PASSWORD=tu_contrasena_de_aplicacion_de_16_caracteres
